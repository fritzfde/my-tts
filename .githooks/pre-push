#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "🔎 Running smoke tests before push..."
if ! npm run test:smoke; then
  echo
  echo "❌ Smoke tests failed. Push aborted."
  echo "You can bypass with 'git push --no-verify' (not recommended)."
  exit 1
fi

echo "✅ Smoke tests passed. Continuing push."
