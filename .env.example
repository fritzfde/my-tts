# Web API -> Python TTS upstream base URL
TTS_SERVER_URL=http://127.0.0.1:5000
SETTINGS_SCOPE=local-dev

# One-command startup settings (scripts/start-all.sh)
VOICE_CLONE_DIR=services/tts
TTS_PORT=5000
